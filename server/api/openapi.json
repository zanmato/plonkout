{
  "components": {
    "schemas": {
      "BeginRecoveryBody": {
        "additionalProperties": false,
        "properties": {
          "recoveryCode": {
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          },
          "username": {
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "username",
          "recoveryCode"
        ],
        "type": "object"
      },
      "BeginSignupBody": {
        "additionalProperties": false,
        "properties": {
          "pow": {
            "$ref": "#/components/schemas/PowSolution"
          },
          "username": {
            "maxLength": 32,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "type": "string"
          },
          "website": {
            "description": "Leave empty.",
            "type": "string"
          }
        },
        "required": [
          "username",
          "pow"
        ],
        "type": "object"
      },
      "CeremonyFinish": {
        "additionalProperties": false,
        "properties": {
          "ceremony": {
            "type": "string"
          },
          "credential": {
            "description": "The result of PublicKeyCredential.toJSON()."
          }
        },
        "required": [
          "ceremony",
          "credential"
        ],
        "type": "object"
      },
      "CeremonyStart": {
        "additionalProperties": false,
        "properties": {
          "ceremony": {
            "description": "Pass back to the matching finish operation.",
            "type": "string"
          },
          "options": {
            "description": "WebAuthn options in their JSON form, for PublicKeyCredential.parse*OptionsFromJSON."
          }
        },
        "required": [
          "ceremony",
          "options"
        ],
        "type": "object"
      },
      "FinishWithName": {
        "additionalProperties": false,
        "properties": {
          "ceremony": {
            "type": "string"
          },
          "credential": {
            "description": "The result of PublicKeyCredential.toJSON()."
          },
          "passkeyName": {
            "description": "A name that helps tell passkeys apart, e.g. the device.",
            "maxLength": 64,
            "type": "string"
          }
        },
        "required": [
          "ceremony",
          "credential"
        ],
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "database": {
            "description": "The database clock, which proves it answered.",
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "examples": [
              "ok"
            ],
            "type": "string"
          },
          "version": {
            "examples": [
              "dev"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "database"
        ],
        "type": "object"
      },
      "Me": {
        "additionalProperties": false,
        "properties": {
          "created": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "passkeys": {
            "format": "int64",
            "type": "integer"
          },
          "recoveryCodesLeft": {
            "format": "int64",
            "type": "integer"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "passkeys",
          "recoveryCodesLeft",
          "id",
          "username",
          "created"
        ],
        "type": "object"
      },
      "Passkey": {
        "additionalProperties": false,
        "properties": {
          "created": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "The credential id, base64url.",
            "type": "string"
          },
          "lastUsed": {
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "synced": {
            "description": "The passkey can be backed up, e.g. to iCloud Keychain or Google Password Manager.",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "created",
          "synced"
        ],
        "type": "object"
      },
      "PowChallenge": {
        "additionalProperties": false,
        "properties": {
          "algorithm": {
            "examples": [
              "SHA-256"
            ],
            "type": "string"
          },
          "challenge": {
            "description": "Hex SHA-256 of salt followed by the secret number.",
            "type": "string"
          },
          "maxNumber": {
            "description": "The secret number is between 0 and this, inclusive.",
            "format": "int64",
            "type": "integer"
          },
          "salt": {
            "type": "string"
          },
          "signature": {
            "description": "Proves the server issued the challenge.",
            "type": "string"
          }
        },
        "required": [
          "algorithm",
          "challenge",
          "maxNumber",
          "salt",
          "signature"
        ],
        "type": "object"
      },
      "PowSolution": {
        "additionalProperties": false,
        "properties": {
          "challenge": {
            "type": "string"
          },
          "number": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "salt": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        },
        "required": [
          "challenge",
          "number",
          "salt",
          "signature"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "examples": [
              "not_found"
            ],
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ProblemDetail"
            },
            "type": "array"
          },
          "status": {
            "examples": [
              404
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "examples": [
              "Not Found"
            ],
            "type": "string"
          },
          "type": {
            "examples": [
              "about:blank"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object"
      },
      "ProblemDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "RenameBody": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "SignedIn": {
        "additionalProperties": false,
        "properties": {
          "recoveryCodes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "user"
        ],
        "type": "object"
      },
      "User": {
        "additionalProperties": false,
        "properties": {
          "created": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "created"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "description": "An OAuth access token, as issued to MCP clients.",
        "scheme": "bearer",
        "type": "http"
      },
      "session": {
        "description": "The web session cookie set by signing in with a passkey.",
        "in": "cookie",
        "name": "__Host-plonkout_sid",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Workout logging and training plans.",
    "title": "Plonkout API",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/account": {
      "delete": {
        "description": "Irreversible. Workouts, plans, templates, settings and passkeys are all removed.",
        "operationId": "delete-account",
        "responses": {
          "204": {
            "description": "No Content",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "session": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Delete the account and everything in it",
        "tags": [
          "account"
        ]
      },
      "get": {
        "operationId": "get-me",
        "responses": {
          "200": {
            "content": {
